# Private key for deployment (DO NOT COMMIT!)
PRIVATE_KEY=your_private_key_here

# BscScan API key for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key

# CoinMarketCap API key for gas reporting
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Report gas usage
REPORT_GAS=false

# Admin wallet address
ADMIN_ADDRESS=0x...

# Fee recipient address
FEE_RECIPIENT=0x...

# Platform fee (in basis points, e.g., 150 = 1.5%)
PLATFORM_FEE=150

# USDC contract address on BSC Mainnet
USDC_ADDRESS=0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56

# Minimum trade amount (in USDC, with 18 decimals)
MIN_TRADE_AMOUNT=1000000000000000000

# Market creation stake (in USDC)
MARKET_CREATION_STAKE=100000000000000000000

# Minimum initial liquidity (in USDC)
MIN_INITIAL_LIQUIDITY=500000000000000000000
