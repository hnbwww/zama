// Prisma Schema for Polymarket BSC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id                String   @id @default(uuid())
  conditionId       String   @unique
  title             String
  description       String
  category          String
  creatorAddress    String
  contractAddress   String?

  // Settlement
  settlementTime    DateTime
  settlementSource  String?
  outcome           Int? // 0 = NO, 1 = YES, 2 = INVALID/VOIDED
  resolvedAt        DateTime?
  voidReason        String?
  status            MarketStatus @default(OPEN)

  // Statistics
  totalVolume       Decimal  @default(0) @db.Decimal(20, 6)
  liquidity         Decimal  @default(0) @db.Decimal(20, 6)
  yesPrice          Decimal? @db.Decimal(10, 6)
  noPrice           Decimal? @db.Decimal(10, 6)

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  orders            Order[]
  trades            Trade[]
  positions         Position[]
  liquidityPositions LiquidityPosition[]
  oracleRequests    OracleRequest[]
  comments          Comment[]

  @@index([category])
  @@index([status])
  @@index([settlementTime])
  @@index([creatorAddress])
}

enum MarketStatus {
  OPEN          // Trading active
  CLOSED        // Trading stopped, awaiting resolution
  RESOLVING     // Oracle resolution in progress
  RESOLVED      // Final outcome determined
  VOIDED        // Market cancelled/invalid
}

// Oracle Resolution Models

model OracleRequest {
  id                  String              @id @default(uuid())
  conditionId         String              @unique
  marketId            String

  question            String
  resolutionSource    String?

  // Status
  status              OracleRequestStatus @default(REQUESTED)

  // Proposal
  proposedOutcome     Int?
  proposerAddress     String?
  proposedAt          DateTime?
  challengeDeadline   DateTime?

  // Dispute
  disputerAddress     String?
  disputeReason       String?
  disputedAt          DateTime?

  // Final resolution
  finalOutcome        Int?
  resolvedAt          DateTime?

  // Void
  voidReason          String?

  // Timestamps
  requestedAt         DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  market              Market              @relation(fields: [marketId], references: [id])
  disputes            OracleDispute[]

  @@index([marketId])
  @@index([status])
  @@index([proposerAddress])
}

enum OracleRequestStatus {
  REQUESTED   // Request created, awaiting proposal
  PROPOSED    // Outcome proposed, in challenge window
  DISPUTED    // Proposal disputed, awaiting arbitration
  RESOLVED    // Final resolution confirmed
  VOIDED      // Market voided/cancelled
}

model OracleDispute {
  id                  String   @id @default(uuid())
  conditionId         String

  disputerAddress     String
  reason              String

  createdAt           DateTime @default(now())

  // Relations
  request             OracleRequest @relation(fields: [conditionId], references: [conditionId])

  @@index([conditionId])
  @@index([disputerAddress])
}

model Order {
  id              String      @id @default(uuid())
  marketId        String
  userAddress     String

  // Order info
  side            OrderSide
  outcome         Outcome
  orderType       OrderType
  price           Decimal?    @db.Decimal(10, 6)
  size            Decimal     @db.Decimal(20, 6)
  filled          Decimal     @default(0) @db.Decimal(20, 6)

  // Status
  status          OrderStatus @default(PENDING)

  // Blockchain
  txHash          String?     @unique
  signature       String
  nonce           BigInt
  expiry          DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  market          Market      @relation(fields: [marketId], references: [id])
  buyTrades       Trade[]     @relation("BuyOrders")
  sellTrades      Trade[]     @relation("SellOrders")

  @@index([marketId, userAddress])
  @@index([status])
  @@index([price])
}

enum OrderSide {
  BUY
  SELL
}

enum Outcome {
  YES
  NO
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  EXPIRED
}

model Trade {
  id              String   @id @default(uuid())
  marketId        String

  // Parties
  buyerAddress    String
  sellerAddress   String

  // Trade info
  outcome         Outcome
  price           Decimal  @db.Decimal(10, 6)
  size            Decimal  @db.Decimal(20, 6)

  // Orders
  buyOrderId      String?
  sellOrderId     String?

  // Blockchain
  txHash          String   @unique
  blockNumber     BigInt

  createdAt       DateTime @default(now())

  // Relations
  market          Market   @relation(fields: [marketId], references: [id])
  buyOrder        Order?   @relation("BuyOrders", fields: [buyOrderId], references: [id])
  sellOrder       Order?   @relation("SellOrders", fields: [sellOrderId], references: [id])

  @@index([marketId])
  @@index([buyerAddress])
  @@index([sellerAddress])
  @@index([createdAt])
}

model Position {
  id              String   @id @default(uuid())
  marketId        String
  userAddress     String

  // Holdings
  yesBalance      Decimal  @default(0) @db.Decimal(20, 6)
  noBalance       Decimal  @default(0) @db.Decimal(20, 6)

  // Cost basis
  yesCostBasis    Decimal  @default(0) @db.Decimal(20, 6)
  noCostBasis     Decimal  @default(0) @db.Decimal(20, 6)

  // PnL
  realizedPnl     Decimal  @default(0) @db.Decimal(20, 6)

  updatedAt       DateTime @updatedAt

  // Relations
  market          Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, userAddress])
  @@index([userAddress])
}

model LiquidityPosition {
  id              String   @id @default(uuid())
  marketId        String
  userAddress     String

  // LP info
  lpTokens        Decimal  @db.Decimal(20, 6)
  usdcDeposited   Decimal  @db.Decimal(20, 6)

  // Fees
  feesEarned      Decimal  @default(0) @db.Decimal(20, 6)

  // Blockchain
  depositTxHash   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  market          Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, userAddress])
}

model User {
  address         String   @id

  // Statistics
  totalTrades     Int      @default(0)
  totalVolume     Decimal  @default(0) @db.Decimal(20, 6)
  totalPnl        Decimal  @default(0) @db.Decimal(20, 6)

  // Admin & Moderation
  isAdmin         Boolean  @default(false)
  isBanned        Boolean  @default(false)
  banReason       String?
  bannedAt        DateTime?

  // Metadata
  firstSeen       DateTime @default(now())
  lastActive      DateTime @default(now())

  @@index([totalVolume])
  @@index([totalPnl])
  @@index([isAdmin])
  @@index([isBanned])
}

model PriceHistory {
  id              String   @id @default(uuid())
  marketId        String

  timestamp       DateTime @default(now())
  yesPrice        Decimal  @db.Decimal(10, 6)
  noPrice         Decimal  @db.Decimal(10, 6)
  volume          Decimal  @db.Decimal(20, 6)

  @@index([marketId, timestamp])
}

// Comment System Models

model Comment {
  id              String   @id @default(uuid())
  marketId        String
  userAddress     String

  content         String
  parentId        String?  // For nested replies

  // Reactions
  upvotes         Int      @default(0)
  downvotes       Int      @default(0)

  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  // Relations
  market          Market   @relation(fields: [marketId], references: [id])
  parent          Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  reactions       CommentReaction[]

  @@index([marketId])
  @@index([userAddress])
  @@index([parentId])
  @@index([createdAt])
}

model CommentReaction {
  id              String   @id @default(uuid())
  commentId       String
  userAddress     String

  type            ReactionType

  createdAt       DateTime @default(now())

  // Relations
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userAddress])
  @@index([commentId])
  @@index([userAddress])
}

enum ReactionType {
  UPVOTE
  DOWNVOTE
}

// Admin Models

model AdminAction {
  id              String         @id @default(uuid())
  adminAddress    String
  actionType      AdminActionType
  targetType      String         // 'market', 'user', 'oracle', etc.
  targetId        String
  description     String
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([adminAddress])
  @@index([actionType])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum AdminActionType {
  MARKET_UPDATE
  MARKET_VOID
  MARKET_CLOSE
  USER_BAN
  USER_UNBAN
  ORACLE_RESOLVE
  ORACLE_DISPUTE
  SYSTEM_CONFIG
}
